<![CDATA[ecmascript:

function initialize ()
{
   set_active (true);
}

function set_active (value)
{
   if (!value)
      return;

   cycleTime         = -1;
   cycleCompleteTime = -1;
   cycleCount        = 0;
   fraction          = 0;
}

function eventsProcessed ()
{
   text .string [0] = `cycleTime: ${cycleTime}`;
   text .string [1] = `cycleCompleteTime: ${cycleCompleteTime}`;
   text .string [2] = `cycleCount: ${cycleCount}`;
   text .string [3] = `fraction: ${fraction .toFixed (3)}`;
}
]]>
